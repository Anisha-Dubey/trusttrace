{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scan_request.schema.json",
  "title": "TRUSTTRACE Scan Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "profile"
  ],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "format": "uri",
      "description": "HTTP(S) URL only. Server-side policy must still validate scheme, DNS and destination IP before egress."
    },
    "profile": {
      "type": "string",
      "enum": [
        "fixture",
        "passive_metadata"
      ]
    },
    "client_request_id": {
      "type": "string",
      "maxLength": 80
    },
    "consent_to_external_lookup": {
      "type": "boolean",
      "default": false
    }
  }
}
